{{ define "content" }}
  {{ $root := . }}
  <section class="admin-page">
    <div class="settings-heading">
      <p class="eyebrow">Administration</p>
      <h1>Configuration</h1>
      <p class="muted">Manage Lore's application settings, integrations, and authentication.</p>
    </div>

    <div class="settings-grid configuration-grid">
      <section class="panel settings-panel settings-wide configuration-runtime">
        <div class="panel-title configuration-panel-title">
          <div>
            <h2>Runtime</h2>
            <p class="muted">Read-only values supplied by the process or deployment.</p>
          </div>
        </div>
        <dl class="configuration-runtime-grid">
          <div>
            <dt>Version</dt>
            <dd>{{ .Version }}</dd>
          </div>
          <div>
            <dt>Commit</dt>
            <dd><code>{{ .Commit }}</code></dd>
          </div>
          <div>
            <dt>Listen address</dt>
            <dd><code>{{ .Runtime.ListenAddress }}</code></dd>
          </div>
          <div>
            <dt>Public URL</dt>
            <dd>{{ .Runtime.PublicURL }}</dd>
          </div>
          <div>
            <dt>Themes</dt>
            <dd>
              {{ if .Runtime.ThemeDirectory }}
                {{ .Runtime.ThemeDirectory }}
              {{ else }}
                Embedded only
              {{ end }}
            </dd>
          </div>
          <div>
            <dt>Application encryption</dt>
            <dd>
              {{ if .Runtime.EncryptionKeyConfigured }}
                Configured
              {{ else }}
                Not configured
              {{ end }}
            </dd>
          </div>
        </dl>
      </section>

      <section class="panel settings-panel configuration-application">
        <div class="panel-title configuration-panel-title">
          <div>
            <h2>Application</h2>
            <p class="muted">General behavior shared by all Lore users.</p>
          </div>
        </div>
        <form class="settings-form" action="/admin/settings" method="post">
          <label class="toggle-row">
            <span>
              <strong>Allow new users</strong>
              <small>Allow unknown OIDC or trusted-proxy identities to create Lore accounts automatically.</small>
            </span>
            <input type="checkbox" name="allow_user_registration" {{ if .ApplicationSettings.AllowUserRegistration }}checked{{ end }} />
          </label>
          <label class="toggle-row">
            <span>
              <strong>Page discussions</strong>
              <small>Allow users to add anchored comments to wiki pages.</small>
            </span>
            <input type="checkbox" name="discussions_enabled" {{ if .ApplicationSettings.DiscussionsEnabled }}checked{{ end }} />
          </label>
          <div class="settings-actions">
            <button class="button primary" type="submit">Save application settings</button>
          </div>
        </form>
      </section>

      <section class="panel settings-panel configuration-pdf" id="pdf-rendering">
        <div class="panel-title configuration-panel-title">
          <div>
            <h2>PDF rendering</h2>
            <p class="muted">Connect Lore to a generic HTML-to-PDF service.</p>
          </div>
          {{ if .Runtime.PDFURL }}
            <span class="config-status warning">Runtime override</span>
          {{ else if .ApplicationSettings.PDFURL }}
            <span class="config-status configured">Configured</span>
          {{ else }}
            <span class="config-status missing">Not configured</span>
          {{ end }}
        </div>

        {{ if .Runtime.PDFURL }}
          <div class="configuration-override-note">
            <strong>Runtime PDF override active</strong>
            <span>
              A deployment-level <code>--pdf-url</code> / <code>LORE__PDF_URL</code> override is currently used for exports: <code>{{ .Runtime.PDFURL }}</code>. The saved endpoint below becomes active after the override is removed and Lore is restarted.
            </span>
          </div>
        {{ end }}

        <form
          class="stacked-form pdf-settings-form"
          action="/admin/pdf"
          method="post"
          data-pdf-settings
          data-validate-form
          novalidate
        >
          <label>
            {{ if .Runtime.PDFURL }}Saved fallback endpoint{{ else }}Endpoint{{ end }}
            <input
              type="url"
              name="pdf_url"
              value="{{ .ApplicationSettings.PDFURL }}"
              placeholder="http://html2pdf:8080/render"
              autocomplete="off"
              data-error-type="Enter a valid HTTP or HTTPS URL."
            />
            <small>Complete <code>POST</code> endpoint including the render path. Leave empty to disable PDF export.</small>
          </label>

          <div class="pdf-header-settings">
            <div class="pdf-header-settings-title">
              <div>
                <strong>Request headers</strong>
                <small>Add headers sent with every PDF render and service-test request.</small>
              </div>
              <button class="button compact" type="button" data-pdf-header-add>{{ icon "plus" 14 }}<span>Add header</span></button>
            </div>

            {{ if .Runtime.EncryptionKeyConfigured }}
              <p class="pdf-header-encryption-note">Sensitive values are encrypted at rest with <code>LORE__ENCRYPTION_KEY</code> and hidden until explicitly revealed.</p>
            {{ else }}
              <p class="pdf-header-encryption-note warning">Configure <code>LORE__ENCRYPTION_KEY</code> before saving, revealing, or reusing stored sensitive headers. Non-sensitive headers do not require an encryption key.</p>
            {{ end }}

            <div class="pdf-header-list" data-pdf-header-list>
              {{ range .PDFHeaders }}
                <div class="pdf-header-row" data-pdf-header-row data-pdf-header-existing="true">
                  <input type="hidden" name="pdf_header_row" value="h{{ .ID }}" />
                  <input type="hidden" name="pdf_header_h{{ .ID }}_id" value="{{ .ID }}" />
                  <label class="pdf-header-name">
                    <span>Name</span>
                    <input
                      type="text"
                      name="pdf_header_h{{ .ID }}_name"
                      value="{{ .Name }}"
                      autocomplete="off"
                      placeholder="Authorization"
                      data-pdf-header-name
                    />
                  </label>
                  <label class="pdf-header-value">
                    <span>Value</span>
                    <input
                      type="{{ if .Sensitive }}password{{ else }}text{{ end }}"
                      name="pdf_header_h{{ .ID }}_value"
                      value="{{ if not .Sensitive }}{{ .Value }}{{ end }}"
                      {{ if and .Sensitive .Configured }}placeholder="•••••••• configured"{{ else }}placeholder="Bearer token"{{ end }}
                      autocomplete="off"
                      data-pdf-header-value
                    />
                  </label>
                  <div class="pdf-header-actions">
                    <label class="pdf-header-sensitive" title="Sensitive: encrypt this header value at rest">
                      <input
                        type="checkbox"
                        name="pdf_header_h{{ .ID }}_sensitive"
                        {{ if .Sensitive }}checked{{ end }}
                        data-pdf-header-sensitive
                        aria-label="Encrypt this header value at rest"
                      />
                      <span class="pdf-header-sensitive-icon" aria-hidden="true">{{ icon "key-round" 14 }}</span>
                    </label>
                    {{ if and .Sensitive .Configured }}
                      <button
                        class="button compact"
                        type="button"
                        data-pdf-header-reveal
                        data-pdf-header-id="{{ .ID }}"
                        {{ if not $.Runtime.EncryptionKeyConfigured }}disabled{{ end }}
                      >Reveal</button>
                    {{ end }}
                    <button class="icon-button" type="button" data-pdf-header-remove aria-label="Remove PDF request header">
                      {{ icon "trash-2" 15 }}
                    </button>
                  </div>
                </div>
              {{ end }}
            </div>

            <template data-pdf-header-template>
              <div class="pdf-header-row" data-pdf-header-row data-pdf-header-existing="false">
                <input type="hidden" data-pdf-header-row-key />
                <input type="hidden" data-pdf-header-id />
                <label class="pdf-header-name">
                  <span>Name</span>
                  <input type="text" autocomplete="off" placeholder="Authorization" data-pdf-header-name />
                </label>
                <label class="pdf-header-value">
                  <span>Value</span>
                  <input type="text" autocomplete="off" placeholder="Bearer token" data-pdf-header-value />
                </label>
                <div class="pdf-header-actions">
                  <label class="pdf-header-sensitive" title="Sensitive: encrypt this header value at rest">
                    <input type="checkbox" data-pdf-header-sensitive aria-label="Encrypt this header value at rest" />
                    <span class="pdf-header-sensitive-icon" aria-hidden="true">{{ icon "key-round" 14 }}</span>
                  </label>
                  <button class="icon-button" type="button" data-pdf-header-remove aria-label="Remove PDF request header">
                    {{ icon "trash-2" 15 }}
                  </button>
                </div>
              </div>
            </template>
          </div>

          <div class="pdf-settings-actions">
            <button class="button" type="button" data-pdf-test>{{ icon "activity" 15 }}<span>Test endpoint</span></button>
            <button class="button primary" type="submit">Save PDF settings</button>
          </div>
          <p class="pdf-test-status" data-pdf-test-status aria-live="polite"></p>
        </form>

        <dialog class="app-dialog pdf-test-dialog" data-pdf-test-dialog aria-labelledby="pdf-test-dialog-title">
          <div class="app-dialog-header">
            <div>
              <p class="eyebrow">PDF rendering</p>
              <h2 id="pdf-test-dialog-title">PDF service test</h2>
            </div>
            <button class="icon-button app-dialog-close" type="button" data-pdf-test-close aria-label="Close">
              {{ icon "x" 18 }}
            </button>
          </div>

          <div class="app-dialog-body pdf-test-dialog-body">
            <div class="pdf-test-summary">
              <strong>PDF service is working.</strong>
              <span>Review the generated document below to confirm that fonts, colors, images, tables, code, and page breaks look acceptable.</span>
            </div>

            <div class="pdf-test-checks" aria-label="PDF service checks">
              <div class="pdf-test-check" data-state="success">
                <span class="pdf-test-check-mark" aria-hidden="true">✓</span>
                <span><strong>Endpoint</strong><small>Reachable</small></span>
              </div>
              <div class="pdf-test-check" data-state="success">
                <span class="pdf-test-check-mark" aria-hidden="true">✓</span>
                <span><strong>PDF</strong><small>Valid response</small></span>
              </div>
              <div class="pdf-test-check" data-pdf-test-pages-check>
                <span class="pdf-test-check-mark" aria-hidden="true">✓</span>
                <span><strong>Pages</strong><small data-pdf-test-pages>2 pages</small></span>
              </div>
              <div class="pdf-test-check" data-state="success">
                <span class="pdf-test-check-mark" aria-hidden="true">✓</span>
                <span><strong>Size</strong><small data-pdf-test-size>—</small></span>
              </div>
            </div>

            <div class="pdf-test-preview-shell">
              <iframe data-pdf-test-preview title="Generated PDF service test document"></iframe>
            </div>
          </div>

          <div class="app-dialog-actions">
            <a class="button" data-pdf-test-open target="_blank" rel="noopener">Open PDF</a>
            <button class="button primary" type="button" data-pdf-test-close>Close</button>
          </div>
        </dialog>
      </section>

      <section class="panel settings-panel settings-wide configuration-authentication">
        <div class="panel-title configuration-panel-title">
          <div>
            <h2>Authentication</h2>
            <p class="muted">Choose how people sign in and configure provider-specific identity settings.</p>
          </div>
          {{ if .Runtime.AuthModeOverride }}<span class="config-status warning">Runtime override</span>{{ end }}
        </div>
        <form class="stacked-form auth-settings-form" action="/admin/authentication" method="post" data-auth-settings>
          {{ if .Runtime.AuthModeOverride }}
            <div class="configuration-override-note">
              <strong>Runtime authentication override active</strong>
              <span>
                A deployment-level <code>--auth-mode</code> / <code>LORE__AUTH_MODE</code> override currently selects <strong>{{ .Runtime.AuthModeOverride }}</strong>. Changes below are saved as the fallback configuration and become active only after the override is removed and Lore is restarted.
              </span>
            </div>
          {{ end }}

          {{ if .Runtime.AuthModeOverride }}
            <label class="auth-mode-field">
              Authentication mode (active)
              <select disabled aria-label="Active authentication mode">
                <option>{{ if eq .Runtime.AuthModeOverride "oidc" }}OpenID Connect (OIDC){{ else if eq .Runtime.AuthModeOverride "local" }}Local account{{ else if eq .Runtime.AuthModeOverride "trusted-proxy" }}Trusted proxy{{ else }}No authentication (development only){{ end }}</option>
              </select>
            </label>
          {{ end }}
          <label class="auth-mode-field">
            {{ if .Runtime.AuthModeOverride }}Saved fallback mode{{ else }}Authentication mode{{ end }}
            <select name="auth_mode" data-auth-mode>
              <option value="none" {{ if eq .ApplicationSettings.Authentication.Mode "none" }}selected{{ end }}>
                No authentication (development only)
              </option>
              <option value="local" {{ if eq .ApplicationSettings.Authentication.Mode "local" }}selected{{ end }}>
                Local account
              </option>
              <option
                value="trusted-proxy"
                {{ if eq .ApplicationSettings.Authentication.Mode "trusted-proxy" }}selected{{ end }}
              >
                Trusted proxy
              </option>
              <option value="oidc" {{ if eq .ApplicationSettings.Authentication.Mode "oidc" }}selected{{ end }}>
                OpenID Connect (OIDC)
              </option>
            </select>
            <small>{{ if .Runtime.AuthModeOverride }}Changes are saved but do not replace the active runtime override.{{ else }}Changes take effect immediately after saving.{{ end }}</small>
          </label>

          <div
            class="auth-mode-options"
            data-auth-fields="local"
            {{ if ne .ApplicationSettings.Authentication.Mode "local" }}hidden{{ end }}
          >
            <div class="admin-card-heading auth-mode-heading">
              <div>
                <h3>Local authentication</h3>
                <p class="muted">Sign in with a Lore-managed administrator password instead of an external provider.</p>
              </div>
            </div>
            <p class="settings-note">At least one administrator must have a local password before this mode can be enabled.</p>
          </div>

          <div
            class="auth-mode-options"
            data-auth-fields="trusted-proxy"
            {{ if ne .ApplicationSettings.Authentication.Mode "trusted-proxy" }}hidden{{ end }}
          >
            <div class="admin-card-heading auth-mode-heading">
              <div>
                <h3>Trusted proxy headers</h3>
                <p class="muted">Only use this mode behind a proxy that removes untrusted client-supplied headers.</p>
              </div>
            </div>
            <div class="form-grid">
              <label>
                Username headers
                <input
                  type="text"
                  name="trusted_username_headers"
                  value="{{ join .ApplicationSettings.Authentication.TrustedUsernameHeaders ", " }}"
                  placeholder="X-Forwarded-User, X-Auth-Request-User"
                  autocomplete="off"
                />
                <small>Required. Checked from left to right.</small>
              </label>
              <label>
                Email headers
                <input
                  type="text"
                  name="trusted_email_headers"
                  value="{{ join .ApplicationSettings.Authentication.TrustedEmailHeaders ", " }}"
                  placeholder="X-Forwarded-Email"
                  autocomplete="off"
                />
                <small>Optional identity metadata.</small>
              </label>
              <label>
                Display-name headers
                <input
                  type="text"
                  name="trusted_display_name_headers"
                  value="{{ join .ApplicationSettings.Authentication.TrustedDisplayNameHeaders ", " }}"
                  placeholder="X-Forwarded-Name"
                  autocomplete="off"
                />
                <small>Optional identity metadata.</small>
              </label>
              <label>
                Group headers
                <input type="text" name="trusted_group_headers" value="{{ join .ApplicationSettings.Authentication.TrustedGroupHeaders ", " }}" placeholder="X-Forwarded-Groups" autocomplete="off" />
                <small>Comma-separated header names supplied and sanitized by the trusted proxy.</small>
              </label>
              <label>
                Administrator group
                <input type="text" name="trusted_admin_group" value="{{ .ApplicationSettings.Authentication.TrustedAdminGroup }}" placeholder="admins" autocomplete="off" />
                <small>A matching value grants administrator access for each trusted request without changing the manually assigned role.</small>
              </label>
            </div>
          </div>

          <div
            class="auth-mode-options"
            data-auth-fields="oidc"
            {{ if ne .ApplicationSettings.Authentication.Mode "oidc" }}hidden{{ end }}
          >
            <div class="admin-card-heading auth-mode-heading">
              <div>
                <h3>OpenID Connect</h3>
                <p class="muted">Configure the public provider details here. Secrets remain deployment-managed.</p>
              </div>
            </div>
            <div class="form-grid">
              <label>
                Issuer URL
                <input
                  type="url"
                  name="oidc_issuer"
                  value="{{ .ApplicationSettings.Authentication.OIDCIssuer }}"
                  placeholder="https://sso.example.com/realms/lore"
                  autocomplete="off"
                />
                <small>Lore verifies provider discovery before saving.</small>
              </label>
              <label>
                Client ID
                <input
                  type="text"
                  name="oidc_client_id"
                  value="{{ .ApplicationSettings.Authentication.OIDCClientID }}"
                  placeholder="lore"
                  autocomplete="off"
                />
                <small>The non-secret client identifier registered with the provider.</small>
              </label>
              <label>
                Administrator group
                <input type="text" name="oidc_admin_group" value="{{ .ApplicationSettings.Authentication.OIDCAdminGroup }}" placeholder="admins" autocomplete="off" />
                <small>A matching value in the group claim grants administrator access at the next login without replacing the manually assigned Lore role.</small>
              </label>
            </div>

            <section class="auth-group-sync" data-oidc-group-sync>
              <div class="admin-card-heading auth-mode-heading">
                <div>
                  <h3>OIDC groups</h3>
                  <p class="muted">Read administrator membership and optional collaboration groups from an ID-token claim.</p>
                </div>
              </div>

              <label>
                Group claim
                <input
                  type="text"
                  name="oidc_group_claim"
                  value="{{ .ApplicationSettings.Authentication.OIDCGroupClaim }}"
                  placeholder="groups"
                  autocomplete="off"
                />
                <small>Top-level ID-token claim containing a string or string array. Required for administrator-group elevation.</small>
              </label>

              <label class="toggle-row">
                <span>
                  <strong>Synchronize mapped groups</strong>
                  <small>Apply configured group mappings after every successful OIDC login.</small>
                </span>
                <input
                  type="checkbox"
                  name="oidc_group_sync"
                  data-oidc-group-sync-toggle
                  {{ if .ApplicationSettings.Authentication.OIDCGroupSync }}checked{{ end }}
                />
              </label>

              <div class="auth-group-sync-options" data-oidc-group-sync-options>
                <label class="toggle-row auth-group-authoritative">
                  <span>
                    <strong>Mapped groups are authoritative</strong>
                    <small
                      >Remove memberships covered by these mappings when the corresponding OIDC group disappears. Other
                      manually managed Lore groups are untouched.</small
                    >
                  </span>
                  <input
                    type="checkbox"
                    name="oidc_groups_authoritative"
                    {{ if .ApplicationSettings.Authentication.OIDCGroupsAuthoritative }}checked{{ end }}
                  />
                </label>

                <div class="auth-group-mappings" data-oidc-group-mappings>
                  <div class="auth-group-mapping-heading">
                    <strong>Mappings</strong>
                    <small class="muted">OIDC group → Lore group</small>
                  </div>

                  <div class="auth-group-mapping-list" data-oidc-group-mapping-list>
                    {{ range .ApplicationSettings.Authentication.OIDCGroupMappings }}
                      {{ $mapping := . }}
                      <div class="auth-group-mapping-row" data-oidc-group-mapping-row>
                        <input
                          type="text"
                          name="oidc_group_source"
                          value="{{ .OIDCGroup }}"
                          placeholder="/platform"
                          aria-label="OIDC group"
                        />
                        <span aria-hidden="true">→</span>
                        <select name="oidc_group_id" aria-label="Lore group">
                          <option value="">Choose Lore group…</option>
                          {{ range $root.Groups }}
                            <option value="{{ .ID }}" {{ if eq .ID $mapping.GroupID }}selected{{ end }}>{{ .Name }}</option>
                          {{ end }}
                        </select>
                        <button class="icon-button" type="button" data-oidc-group-mapping-remove aria-label="Remove group mapping">
                          {{ icon "x" 16 }}
                        </button>
                      </div>
                    {{ end }}
                  </div>

                  {{ if .Groups }}
                    <button class="button compact" type="button" data-oidc-group-mapping-add>
                      {{ icon "plus" 15 }}<span>Add mapping</span>
                    </button>
                    <template data-oidc-group-mapping-template>
                      <div class="auth-group-mapping-row" data-oidc-group-mapping-row>
                        <input
                          type="text"
                          name="oidc_group_source"
                          placeholder="/platform"
                          aria-label="OIDC group"
                        />
                        <span aria-hidden="true">→</span>
                        <select name="oidc_group_id" aria-label="Lore group">
                          <option value="">Choose Lore group…</option>
                          {{ range .Groups }}<option value="{{ .ID }}">{{ .Name }}</option>{{ end }}
                        </select>
                        <button class="icon-button" type="button" data-oidc-group-mapping-remove aria-label="Remove group mapping">
                          {{ icon "x" 16 }}
                        </button>
                      </div>
                    </template>
                  {{ else }}
                    <p class="muted auth-group-mapping-empty">Create a Lore group before adding OIDC mappings.</p>
                  {{ end }}
                </div>
              </div>
            </section>

            <div class="auth-secret-summary">
              <div>
                <span>OIDC client secret</span>
                {{ if .Runtime.OIDCClientSecretConfigured }}
                  <strong class="config-status configured">Configured</strong>
                {{ else }}
                  <strong class="config-status missing">Missing</strong>
                {{ end }}
                <small><code>LORE__OIDC_CLIENT_SECRET</code></small>
              </div>
              <div>
                <span>Session secret</span>
                {{ if .Runtime.OIDCSessionSecretConfigured }}
                  <strong class="config-status configured">Configured</strong>
                {{ else }}
                  <strong class="config-status missing">Missing</strong>
                {{ end }}
                <small><code>LORE__OIDC_SESSION_SECRET</code>, at least 32 characters</small>
              </div>
            </div>
          </div>

          <div class="settings-actions auth-settings-actions">
            <button class="button primary" type="submit">{{ if .Runtime.AuthModeOverride }}Save fallback authentication settings{{ else }}Save authentication settings{{ end }}</button>
          </div>
        </form>

        <p class="settings-note">Manage local passwords in <a href="/admin/users">Users</a>.</p>

      </section>

    </div>
  </section>
{{ end }}


