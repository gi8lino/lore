{{ define "content" }}
  <section class="admin-heading">
    <div>
      <p class="eyebrow">Administration</p>
      <h1>Snippets</h1>
      <p>Keep reusable Markdown blocks in one canonical place.</p>
    </div>
  </section>
  <div class="admin-workspace-grid">
    <section class="panel admin-compact-form">
      <div class="admin-card-heading">
        <span class="admin-card-icon">{{ icon "braces-lucide" 20 }}</span>
        <div>
          <h2>New Markdown snippet</h2>
          <p class="muted"><code>{{ "{{snippet:name }}"}}</code> inserts the stored Markdown.</p>
        </div>
      </div>
      <form action="/admin/snippets" method="post" class="stacked-form">
        <label>
          Name<input name="name" required placeholder="shared-warning" autocomplete="off" />
        </label>
        <label>
          Description <span class="optional">optional</span><input name="description"
       placeholder="Where this reusable snippet is used" />
        </label>
        <label>
          Markdown<textarea name="content" rows="8" required placeholder="Reusable Markdown…"></textarea>
        </label>
        <div class="form-actions">
          <button class="button primary" type="submit">{{ icon "plus-lucide" 16 }}<span>Create</span></button>
        </div>
      </form>
    </section>
    <section class="panel admin-library-panel">
      <div class="panel-title">
        <div>
          <h2>Markdown snippets</h2>
          <p class="muted">Changes are reflected wherever the snippet macro is rendered.</p>
        </div>
        <span class="count-chip">{{ len .KnowledgeSnippets }}</span>
      </div>
      <div class="admin-expand-list">
        {{ range .KnowledgeSnippets }}
          <details class="admin-expand-item">
            <summary>
              <span class="admin-expand-icon">{{ icon "braces-lucide" 17 }}</span><span><strong>{{ .Name }}</strong><small>{{ if .Description }}{{ .Description }}{{ else }}Markdown snippet{{ end }}</small></span>{{ icon "chevron-down-lucide" 15 }}
            </summary>
            <form action="/admin/snippets/{{ .ID }}"
                  method="post"
                  class="stacked-form admin-expand-body">
              <label>
                Name<input name="name" value="{{ .Name }}" required />
              </label>
              <label>
                Description<input name="description" value="{{ .Description }}" />
              </label>
              <label>
                Markdown<textarea name="content" rows="8" required>{{ .Content }}</textarea>
              </label>
              <div class="form-actions">
                <button class="button primary" type="submit">{{ icon "save-lucide" 15 }}<span>Save</span></button><button class="button danger"
        type="submit"
        formaction="/admin/snippets/{{ .ID }}/delete"
        data-confirm="Delete this Markdown snippet?">
                  {{ icon "trash-2-lucide" 15 }}<span>Delete</span>
                </button>
              </div>
            </form>
          </details>
        {{ else }}
          <div class="empty">
            <strong>No Markdown snippets yet.</strong>
            <p>Create a snippet to remove duplicated Markdown content.</p>
          </div>
        {{ end }}
      </div>
    </section>
  </div>
{{ end }}
