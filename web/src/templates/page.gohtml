{{ define "subpage-entry" }}
  <li class="subpage-toc-item">
    {{ if .Page }}
      <a class="subpage-toc-link" href="/pages/{{ .Slug }}">
        {{ if .Icon }}<span class="subpage-toc-node-icon" aria-hidden="true">{{ icon .Icon 17 }}</span>{{ end }}
        <span>{{ .Title }}</span>
      </a>
    {{ else }}
      <span class="subpage-toc-label">
        {{ if .Icon }}<span class="subpage-toc-node-icon" aria-hidden="true">{{ icon .Icon 17 }}</span>{{ end }}
        <span>{{ .Title }}</span>
      </span>
    {{ end }}
    {{ if .Children }}
      <ul class="subpage-toc-list">
        {{ range .Children }}{{ template "subpage-entry" . }}{{ end }}
      </ul>
    {{ end }}
  </li>
{{ end }}

{{ define "subpage-toc" }}
  {{ if .Subpages }}
    <nav class="subpage-toc" aria-label="Pages in this section">
      <div class="subpage-toc-heading">
        <span aria-hidden="true">{{ icon "list-tree" 18 }}</span>
        <h2>Pages in this section</h2>
      </div>
      <ul class="subpage-toc-list subpage-toc-root">
        {{ range .Subpages }}{{ template "subpage-entry" . }}{{ end }}
      </ul>
    </nav>
  {{ end }}
{{ end }}

{{ define "content" }}
  <article class="page" data-page-layout>
    <div class="page-heading">
      <div>
        <p class="breadcrumbs">Pages / {{ .Page.Slug }}</p>
        <h1 class="page-title-with-icon" lang="{{ .PageContentLanguage }}">
          {{ if .Page.Icon }}
            <span class="page-title-icon" aria-hidden="true">{{ icon .Page.Icon 28 }}</span>
          {{ end }}<span>{{ .Page.Title }}</span>
        </h1>
        <div class="page-labels">
          <span class="page-status-badge status-{{ .Page.Status }}">{{ .Page.Status }}</span>
          <div class="tags">{{ range .Page.Tags }}<a href="/search?q=tag%3A{{ . }}">{{ . }}</a>{{ end }}</div>
          {{ if .Page.Groups }}
            <div class="page-groups" aria-label="Page groups">
              {{ range .Page.Groups }}
                <span class="page-group-badge" title="Collaboration group">{{ .Name }}</span>
              {{ end }}
            </div>
          {{ end }}
          {{ if .Page.OwnerGroup }}
            <span class="page-owner-badge" title="Documentation owner"
              >{{ icon "shield-check" 13 }}<span>{{ .Page.OwnerGroup }}</span></span
            >
          {{ end }}
        </div>
        {{ if .Page.Properties }}
          <dl class="page-property-strip">
            {{ range .Page.Properties }}
              <div>
                <dt>{{ .Key }}</dt>
                <dd>{{ .Value }}</dd>
              </div>
            {{ end }}
          </dl>
        {{ end }}
      </div>
      <div class="actions">
        <form action="/pages/{{ .Page.Slug }}/favorite" method="post">
          <input type="hidden" name="on" value="{{ if .PageFavorite }}false{{ else }}true{{ end }}" />
          <button
            class="button icon-only{{ if .PageFavorite }}active{{ end }}"
            type="submit"
            aria-label="{{ if .PageFavorite }}
              Remove from pinned pages
            {{ else }}
              Pin page
            {{ end }}"
            title="{{ if .PageFavorite }}
              Remove from pinned pages
            {{ else }}
              Pin page
            {{ end }}"
          >
            {{ icon "star" 17 }}
          </button>
        </form>
        <button
          class="button icon-only"
          type="button"
          data-share-dialog-open
          aria-label="Share or export page"
          title="Share or export"
        >
          {{ icon "share-2" 17 }}
        </button>
        <a
          class="button icon-only"
          href="/graph?slug={{ .Page.Slug }}"
          aria-label="Explore page relationships"
          title="Knowledge graph"
          >{{ icon "network" 17 }}</a
        >
        {{ if .ApplicationSettings.DiscussionsEnabled }}
          <button
            class="button icon-only"
            type="button"
            data-comment-dialog-open
            aria-label="Comment on page"
            title="Comment"
          >
            {{ icon "message-square-plus" 17 }}
          </button>
        {{ end }}
        {{ if .CanEdit }}
          <a class="button icon-only" href="/edit/{{ .Page.Slug }}" aria-label="Edit page" title="Edit page"
            >{{ icon "pencil" 17 }}</a
          >
          <button class="button icon-only" type="button" data-move-page-open aria-label="Move page" title="Move page">
            {{ icon "folder-input" 17 }}
          </button>
        {{ end }}
        {{ if eq .User.Role "admin" }}
          <form
            action="/pages/delete/{{ .Page.Slug }}"
            method="post"
            data-confirm="Move {{ .Page.Title }} to the recycle bin? An administrator can restore it later."
            data-confirm-title="Move page to recycle bin"
            data-confirm-label="Move to bin"
          >
            <button class="button icon-only danger" type="submit" aria-label="Delete page" title="Delete page">
              {{ icon "trash-2" 17 }}
            </button>
          </form>
        {{ end }}
      </div>
    </div>

    {{ if eq .Page.Status "deprecated" }}
      <aside class="page-lifecycle-banner deprecated">
        {{ icon "triangle-alert" 18 }}
        <div>
          <strong>This page is deprecated.</strong>{{ if .Page.DeprecatedTarget }}
            <span>Use <a href="/pages/{{ .Page.DeprecatedTarget }}">{{ .Page.DeprecatedTarget }}</a> instead.</span>
          {{ else }}
            <span>Review it before following these instructions.</span>
          {{ end }}
        </div>
      </aside>
    {{ else if eq .Page.Status "draft" }}
      <aside class="page-lifecycle-banner draft">
        {{ icon "file-pen-line" 18 }}
        <div><strong>Draft documentation.</strong> <span>This page has not been verified yet.</span></div>
      </aside>
    {{ else if eq .Page.Status "archived" }}
      <aside class="page-lifecycle-banner archived">
        {{ icon "archive" 18 }}
        <div><strong>Archived documentation.</strong> <span>This page is retained for historical context.</span></div>
      </aside>
    {{ end }}


    <div
      class="page-reading{{ if .PageContents }}
        {{ if .Preferences.ShowPageContents }}with-contents{{ else }}contents-hidden{{ end }}
      {{ end }}"
    >
      <div class="prose" lang="{{ .PageContentLanguage }}">
        {{ .HTML }}
      </div>
      {{ template "page-contents" . }}
    </div>

    <details class="page-details">
      <summary class="page-details-summary" title="Show page details">
        <span class="page-meta"
          >Updated {{ timeago .Page.UpdatedAt }} by {{ .Page.Author }} · {{ .Page.ViewCount }}
          views{{ if gt .Page.ReviewIntervalDays 0 }}· review every {{ .Page.ReviewIntervalDays }}d{{ end }}</span
        >
        <span class="page-details-icon" aria-hidden="true">{{ icon "info" 17 }}</span>
        <span class="sr-only">Show related pages, backlinks, and revision history</span>
      </summary>
      <div class="relations">
        <section>
          <h2>Related pages</h2>
          {{ range .Related }}
            {{ template "compact-row" . }}
          {{ else }}
            <p class="muted">No related pages yet.</p>
          {{ end }}
        </section>
        <section>
          <h2>Referenced by</h2>
          {{ range .Backlinks }}
            {{ template "compact-row" . }}
          {{ else }}
            <p class="muted">No backlinks yet.</p>
          {{ end }}
        </section>
        <section>
          <h2>Links from this page</h2>
          <div class="page-link-list">
            {{ range .OutgoingLinks }}
              {{ if .Exists }}
                <a href="/pages/{{ .TargetSlug }}"
                  ><strong>{{ if .TargetTitle }}{{ .TargetTitle }}{{ else }}{{ .TargetSlug }}{{ end }}</strong
                  ><small>{{ .TargetSlug }}</small></a
                >
              {{ else }}
                <a class="page-link-broken" href="/pages/new?slug={{ .TargetSlug }}"
                  ><strong>{{ .TargetSlug }}</strong><small>Missing page · create it</small></a
                >
              {{ end }}
            {{ else }}
              <p class="muted">No wiki links yet.</p>
            {{ end }}
          </div>
        </section>
        {{ if gt .Page.ReviewIntervalDays 0 }}
          <section>
            <h2>Documentation review</h2>
            <p class="muted">
              {{ if .Page.LastReviewedAt }}
                Last reviewed {{ .Page.LastReviewedAt.Format "2006-01-02" }}.
              {{ else }}
                This page has never been explicitly reviewed.
              {{ end }}{{ if .Page.OwnerGroup }}Owner: {{ .Page.OwnerGroup }}.{{ end }}
            </p>
            {{ if .CanEdit }}
              <form action="/pages/review/{{ .Page.Slug }}" method="post">
                <button class="button" type="submit">{{ icon "badge-check" 15 }}<span>Mark reviewed</span></button>
              </form>
            {{ end }}
          </section>
        {{ end }}
        <section>
          <h2>Revision history</h2>
          {{ if .LatestRevision }}
            {{ template "revision-item" .LatestRevision }}
            {{ if gt .RevisionCount 1 }}
              <button
                class="revision-history-link"
                type="button"
                data-revision-dialog-open
                data-revision-url="/revisions/{{ .Page.Slug }}"
              >
                {{ icon "history" 14 }}<span>All {{ .RevisionCount }} revisions</span>{{ icon "chevron-right" 13 }}
              </button>
            {{ end }}
          {{ else }}
            <p class="muted">No revision history available.</p>
          {{ end }}
        </section>
      </div>
    </details>

    {{ if .ApplicationSettings.DiscussionsEnabled }}
      <section class="page-comments" id="comments">
        <div class="panel-title">
          <div>
            <h2>Discussion</h2>
            <p class="muted">Comments can be anchored to selected page text.</p>
          </div>
          <button class="button compact" type="button" data-comment-dialog-open>
            {{ icon "message-square-plus" 15 }}<span>Comment</span>
          </button>
        </div>
        <div class="page-comment-list">
          {{ range .Comments }}
            <article class="page-comment{{ if .Resolved }}resolved{{ end }}">
              <header>
                <div><strong>{{ .Author }}</strong><span class="muted">{{ timeago .CreatedAt }}</span></div>
                {{ if .Resolved }}<span class="page-status-badge status-archived">Resolved</span>{{ end }}
              </header>
              {{ if .Anchor }}<blockquote>{{ .Anchor }}</blockquote>{{ end }}
              <p>{{ .Body }}</p>
              {{ if $.CanEdit }}
                <form action="/page-comments/resolve/{{ .ID }}" method="post">
                  <input type="hidden" name="next" value="/pages/{{ $.Page.Slug }}" /><input
                    type="hidden"
                    name="resolved"
                    value="{{ if .Resolved }}
                      false
                    {{ else }}
                      true
                    {{ end }}"
                  /><button class="button compact" type="submit">
                    {{ if .Resolved }}
                      Reopen
                    {{ else }}
                      Resolve
                    {{ end }}
                  </button>
                </form>
              {{ end }}
            </article>
          {{ else }}
            <p class="muted">No discussion yet.</p>
          {{ end }}
        </div>
      </section>
    {{ end }}
  </article>

  {{ if .PageContents }}
    <button
      class="contents-backdrop"
      type="button"
      data-page-contents-backdrop
      aria-label="Close page contents"
      hidden
    ></button>
    <button
      class="contents-toggle"
      type="button"
      data-page-contents-toggle
      data-preference-url="/settings/preferences/page-contents"
      aria-controls="page-contents"
      aria-expanded="false"
      aria-pressed="{{ if .Preferences.ShowPageContents }}
        true
      {{ else }}
        false
      {{ end }}"
      aria-label="{{ if .Preferences.ShowPageContents }}
        Hide page contents
      {{ else }}
        Show page contents
      {{ end }}"
      title="{{ if .Preferences.ShowPageContents }}
        Hide page contents
      {{ else }}
        Show page contents
      {{ end }}"
    >
      {{ icon "list" 17 }}
    </button>
  {{ end }}


  <dialog class="share-dialog" data-share-dialog aria-labelledby="share-dialog-title">
    <div class="app-dialog-header">
      <div>
        <p class="eyebrow">{{ .Page.Title }}</p>
        <h2 id="share-dialog-title">Share and export</h2>
      </div>
      <button class="icon-button app-dialog-close" type="button" data-share-dialog-close aria-label="Close">
        {{ icon "x" 20 }}
      </button>
    </div>
    <div class="share-dialog-options">
      <button class="share-option" type="button" data-share-permalink data-url="/p/{{ .Page.ID }}">
        <span class="share-option-icon">{{ icon "link" 22 }}</span>
        <span
          ><strong>Copy permalink</strong
          ><small data-share-permalink-status>Stable page link. Lore sign-in is still required.</small></span
        >
      </button>
      <button class="share-option" type="button" data-share-print>
        <span class="share-option-icon">{{ icon "printer" 22 }}</span>
        <span><strong>Print</strong><small>Open the browser print dialog.</small></span>
      </button>
      <button class="share-option" type="button" data-share-pdf data-url="/export/pdf/{{ .Page.Slug }}">
        <span class="share-option-icon">{{ icon "file-down" 22 }}</span>
        <span><strong>Export PDF</strong><small>Generate a printable PDF on the server.</small></span>
      </button>
      <a class="share-option" href="/export/markdown/{{ .Page.Slug }}" data-share-markdown>
        <span class="share-option-icon">{{ icon "file-text" 22 }}</span>
        <span
          ><strong>Export Markdown</strong
          ><small>Download .md directly; a ZIP is used only when referenced images must be included.</small></span
        >
      </a>
    </div>
    <div class="share-progress" data-share-progress hidden>
      <span class="spinner" aria-hidden="true"></span><span>Generating PDF…</span>
    </div>
  </dialog>

  <dialog class="app-dialog" data-move-page-dialog aria-labelledby="move-page-title">
    <div class="app-dialog-header">
      <div>
        <p class="eyebrow">Refactor</p>
        <h2 id="move-page-title">Move page</h2>
      </div>
      <button class="icon-button app-dialog-close" type="button" data-move-page-close aria-label="Close">
        {{ icon "x" 20 }}
      </button>
    </div>
    <form action="/pages/move/{{ .Page.Slug }}" method="post" class="app-dialog-body stacked-form">
      <label>New page path<input name="slug" value="{{ .Page.Slug }}" required autocomplete="off" /></label>
      <label class="toggle-row compact"
        ><span><strong>Move child pages</strong><small>Move the complete subtree under the new path.</small></span
        ><input type="checkbox" name="move_children" checked
      /></label>
      <label class="toggle-row compact"
        ><span
          ><strong>Update incoming links</strong
          ><small>Refactor direct <code>[[path]]</code> references and create revisions for changed pages.</small></span
        ><input type="checkbox" name="update_links" checked
      /></label>
      <label class="toggle-row compact"
        ><span><strong>Keep redirects</strong><small>Old paths continue to redirect to the moved pages.</small></span
        ><input type="checkbox" name="keep_aliases" checked
      /></label>
      <div class="app-dialog-actions">
        <button class="button" type="button" data-move-page-close>Cancel</button
        ><button class="button primary" type="submit">{{ icon "folder-input" 16 }}<span>Move page</span></button>
      </div>
    </form>
  </dialog>

  {{ if .ApplicationSettings.DiscussionsEnabled }}
    <dialog class="app-dialog" data-comment-dialog aria-labelledby="comment-dialog-title">
      <div class="app-dialog-header">
        <div>
          <p class="eyebrow">Discussion</p>
          <h2 id="comment-dialog-title">Add comment</h2>
        </div>
        <button class="icon-button app-dialog-close" type="button" data-comment-dialog-close aria-label="Close">
          {{ icon "x" 20 }}
        </button>
      </div>
      <form action="/page-comments/{{ .Page.Slug }}" method="post" class="app-dialog-body stacked-form">
        <label
          >Anchor <span class="optional">optional</span
          ><textarea
            name="anchor"
            rows="2"
            data-comment-anchor
            placeholder="Select text on the page before opening this dialog, or describe the section here."
          ></textarea>
        </label>
        <label
          >Comment<textarea
            name="body"
            rows="5"
            required
            placeholder="Add context or mention @username…"
            data-mention-autocomplete
          ></textarea>
        </label>
        <div class="app-dialog-actions">
          <button class="button" type="button" data-comment-dialog-close>Cancel</button
          ><button class="button primary" type="submit">{{ icon "send" 15 }}<span>Add comment</span></button>
        </div>
      </form>
    </dialog>
  {{ end }}

  {{ if gt .RevisionCount 1 }}
    <dialog class="revision-dialog" data-revision-dialog aria-labelledby="revision-dialog-title">
      <div class="revision-dialog-header">
        <div>
          <p class="eyebrow">{{ .Page.Title }}</p>
          <h2 id="revision-dialog-title">Revision history</h2>
        </div>
        <button
          class="icon-button revision-dialog-close"
          type="button"
          data-revision-dialog-close
          aria-label="Close revision history"
        >
          {{ icon "x" 20 }}
        </button>
      </div>
      <div class="revision-dialog-body" data-revision-dialog-body>
        <p class="muted">Loading revision history…</p>
      </div>
    </dialog>
  {{ end }}
{{ end }}

