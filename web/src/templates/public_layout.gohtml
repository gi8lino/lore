{{ define "public-layout" }}
  <!doctype html>
  <html lang="en" data-theme="{{ .ActiveTheme }}">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width,initial-scale=1" />
      <meta name="color-scheme" content="light dark" />
      <title>{{ .Title }} · Lore</title>
      <link rel="icon" href="/assets/v-{{ .AssetVersion }}/favicon.svg" type="image/svg+xml" />
      <link rel="stylesheet" href="/assets/v-{{ .AssetVersion }}/css/app.css" />
    </head>
    <body class="auth-page">
      <main class="auth-shell">
        <div class="auth-brand" aria-label="Lore">{{ logo }}</div>
        {{ template "content" . }}
      </main>
      <footer>Lore {{ .Version }} · Markdown-first knowledge</footer>
    </body>
  </html>
{{ end }}
