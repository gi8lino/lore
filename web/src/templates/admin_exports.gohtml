{{ define "content" }}
  <section class="admin-page">
    <div class="settings-heading">
      <p class="eyebrow">Administration</p>
      <h1>Exports</h1>
      <p class="muted">Export selected pages as a portable archive that Kumbuka can import directly.</p>
    </div>
    <section class="panel settings-panel">
      <p class="settings-note">
        Administration exports use the versioned Kumbuka archive format with <code>manifest.json</code>, Markdown under
        <code>pages/</code>, page metadata under <code>metadata/</code>, and bundled files under <code>media/</code> and
        <code>attachments/</code>. <strong>Export all</strong> also includes stored images and attachments that are not
        currently referenced by a page.
      </p>
      <form action="/admin/export" method="post" data-export-form>
        <div class="export-actions">
          <button class="button primary" type="submit">Export selected</button>
          <button class="button" type="submit" name="all" value="true">Export all</button>
          <label>
            <input type="checkbox" data-export-all />
            Select all
          </label>
        </div>
        <div class="export-pages">
          {{ range .AdminPages }}
            <label>
              <input type="checkbox" name="slug" value="{{ .Slug }}" />
              <span><strong>{{ .Title }}</strong><small>{{ .Slug }}</small></span>
            </label>
          {{ else }}
            <p class="muted">No pages to export.</p>
          {{ end }}
        </div>
      </form>
    </section>
  </section>
{{ end }}
