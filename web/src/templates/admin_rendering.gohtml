{{ define "content" }}
  <section class="admin-page">
    <div class="settings-heading">
      <p class="eyebrow">Administration</p>
      <h1>Rendering</h1>
      <p class="muted">Configure Lore's built-in Markdown behavior. Plugin rendering features are managed under <a href="/admin/plugins">Plugins</a>.</p>
    </div>
    <form class="settings-form rendering-settings"
          action="/admin/rendering"
          method="post">
      <section class="panel settings-panel">
        <div class="panel-title">
          <h2>Lore extensions</h2>
        </div>
        <div class="render-setting-list">
          <article class="render-setting-card">
            <label class="toggle-row">
              <span><strong>Wiki links</strong><small>Resolve <code>[[Page]]</code> and <code>[[Page|label]]</code> references.</small></span><input type="checkbox"
       name="wiki_links"
       {{ if .ApplicationSettings.Rendering.WikiLinks }}checked{{ end }} />
            </label>
            <div class="render-setting-preview prose">
              <span class="render-preview-label">Preview</span>{{ index .RenderingPreviews "wiki_links" }}
            </div>
          </article>
        </div>
      </section>
      <section class="panel settings-panel">
        <div class="panel-title">
          <h2>Markdown extensions</h2>
        </div>
        <div class="render-setting-list">
          <article class="render-setting-card">
            <label class="toggle-row">
              <span><strong>Syntax highlighting</strong><small>Apply server-side syntax highlighting to fenced code blocks.</small></span><input type="checkbox"
       name="syntax_highlighting"
       {{ if .ApplicationSettings.Rendering.SyntaxHighlighting }}checked{{ end }} />
            </label>
            <div class="render-setting-preview prose">
              <span class="render-preview-label">Preview</span>{{ index .RenderingPreviews "syntax_highlighting" }}
            </div>
          </article>
          <article class="render-setting-card">
            <label class="toggle-row">
              <span><strong>Definition lists</strong><small>Enable term/definition list syntax.</small></span><input type="checkbox"
       name="definition_lists"
       {{ if .ApplicationSettings.Rendering.DefinitionLists }}checked{{ end }} />
            </label>
            <div class="render-setting-preview prose">
              <span class="render-preview-label">Preview</span>{{ index .RenderingPreviews "definition_lists" }}
            </div>
          </article>
          <article class="render-setting-card">
            <label class="toggle-row">
              <span><strong>Typographer</strong><small>Convert common punctuation sequences to typographic characters.</small></span><input type="checkbox"
       name="typographer"
       {{ if .ApplicationSettings.Rendering.Typographer }}checked{{ end }} />
            </label>
            <div class="render-setting-preview prose">
              <span class="render-preview-label">Preview</span>{{ index .RenderingPreviews "typographer" }}
            </div>
          </article>
        </div>
      </section>
      <div class="settings-actions">
        <button class="button primary" type="submit">Save rendering settings</button>
      </div>
    </form>
  </section>
{{ end }}
